  "DemandSignal": {
    "class": "DemandSignal",
    "fields": [
      {
        "name": "category",
        "type": "string",
        "required_in_step": true,
        "dispatches_to": {
          "ClothingItem": "ClothingItem",
          "AccessoriesItem": "AccessoriesItem",
          "FootwearItem": "FootwearItem",
          "FurnitureItem": "FurnitureItem",
          "BeddingTextilesItem": "BeddingTextilesItem",
          "HouseholdItem": "HouseholdItem",
          "ElectronicsItem": "ElectronicsItem",
          "ToysItem": "ToysItem",
          "SportsItem": "SportsItem",
          "BooksItem": "BooksItem",
          "StationeryItem": "StationeryItem",
          "PersonalCareItem": "PersonalCareItem",
          "MobilityAidsItem": "MobilityAidsItem",
          "BabyInfantItem": "BabyInfantItem",
          "FoodItem": "FoodItem",
          "OtherItem": "OtherItem"
        },
        "completeness": "minimal"
      },
      {
        "name": "urgency_tier",
        "type": "enum",
        "enum": "UrgencyTierEnum",
        "required_in_step": false,
        "completeness": "standard"
      },
      {
        "name": "household_situation",
        "type": "enum",
        "enum": "HouseholdSituationEnum",
        "required_in_step": false,
        "completeness": "standard"
      }
    ],
    "enums": {
      "UrgencyTierEnum": [
        { "value": "low",      "label_en": "Low",      "color_hint": "info",      "deadline_days": 28 },
        { "value": "medium",   "label_en": "Medium",   "color_hint": "amber",     "deadline_days": 14 },
        { "value": "high",     "label_en": "High",     "color_hint": "warm_red",  "deadline_days": 7  },
        { "value": "critical", "label_en": "Critical", "color_hint": "warm_red",  "deadline_days": 3, "triggers_notification": true }
      ],
      "HouseholdSituationEnum": [ "single_adult", "couple_no_children", "single_parent", "family_with_children", "multigenerational", "other" ]
    }
  },
  "ClothingItem": {
    "class": "ClothingItem",
    "fields": [
      {
        "name": "subcategory",
        "type": "enum",
        "required_in_step": true,
        "enum": "ClothingSubcategoryEnum",
        "completeness": "minimal"
      },
      {
        "name": "demographic",
        "type": "enum",
        "required_in_step": true,
        "enum": "DemographicEnum",
        "completeness": "minimal",
        "options_depend_on": [
          {
            "when": {
              "subcategory": [
                "underwear"
              ]
            },
            "options": [
              "baby",
              "child",
              "adult_male",
              "adult_female"
            ]
          }
        ]
      },
      {
        "name": "size",
        "type": "enum",
        "required_in_step": true,
        "enum": "ClothingSizeEnum",
        "completeness": "minimal",
        "options_depend_on": [
          {
            "when": {
              "demographic": [
                "baby"
              ]
            },
            "options": [
              "baby_0_3m",
              "baby_3_6m",
              "baby_6_12m",
              "baby_12_18m",
              "baby_18_24m"
            ]
          },
          {
            "when": {
              "demographic": [
                "child"
              ]
            },
            "options": [
              "child_2_3T",
              "child_4_5T",
              "child_6_7",
              "child_8_10",
              "child_12_14"
            ]
          },
          {
            "when": {
              "demographic": [
                "adult_male",
                "adult_female",
                "unisex"
              ]
            },
            "options": [
              "xs_s",
              "m_l",
              "xl_plus",
              "one_size"
            ]
          }
        ]
      },
      {
        "name": "is_winter_suitable",
        "type": "boolean",
        "required_in_step": false,
        "completeness": "standard",
        "visible_when": {
          "subcategory": [
            "tops",
            "bottoms",
            "outerwear",
            "nightwear"
          ]
        },
        "auto_set_from": {
          "season": {
            "winter": true,
            "summer": false,
            "all_season": true
          }
        }
      },
      {
        "name": "material",
        "type": "enum",
        "required_in_step": false,
        "enum": "ClothingMaterialEnum",
        "completeness": "detailed"
      },
      {
        "name": "season",
        "type": "enum",
        "required_in_step": false,
        "enum": "SeasonEnum",
        "multivalued": true,
        "completeness": "detailed",
        "options_depend_on": [
          {
            "when": {
              "is_winter_suitable": [
                "false"
              ]
            },
            "options": [
              "summer",
              "spring_autumn"
            ]
          }
        ]
      },
      {
        "name": "intact_labels",
        "type": "boolean",
        "required_in_step": false,
        "completeness": "detailed"
      },
      {
        "name": "category",
        "type": "string",
        "required_in_step": true,
        "dispatches_to": {
          "ClothingItem": "ClothingItem",
          "AccessoriesItem": "AccessoriesItem",
          "FootwearItem": "FootwearItem",
          "FurnitureItem": "FurnitureItem",
          "BeddingTextilesItem": "BeddingTextilesItem",
          "HouseholdItem": "HouseholdItem",
          "ElectronicsItem": "ElectronicsItem",
          "ToysItem": "ToysItem",
          "SportsItem": "SportsItem",
